# AT Group Chat local environment template.
# Copy to .env or export the variables in your shell. Do not commit real tokens.

# Local admin token for HTTP, SDK, MCP, and UI access.
# Generate with: at-group-chat token --env
AT_TEAM_API_TOKEN=

# Separate token for /api/hooks/events from CI/webhooks.
AT_TEAM_HOOK_TOKEN=

# Runtime mode. Use mock for demos/tests and real for actual local agents.
AT_TEAM_AGENT_MODE=real

# HTTP API port. PORT also works and takes precedence in some host environments.
AT_TEAM_PORT=5174

# Codex app-server WebSocket endpoint.
CODEX_APP_SERVER_URL=ws://127.0.0.1:5176

# SQLite source-of-truth database path.
AT_TEAM_DB_PATH=./data/at-team.sqlite

# Static UI directory for packaged serve mode.
AT_TEAM_PUBLIC_DIR=./dist

# CORS and input limits.
AT_TEAM_CORS_ORIGIN=http://127.0.0.1:5173
AT_TEAM_MAX_BODY_BYTES=1048576
AT_TEAM_MAX_TEXT_FIELD_LENGTH=32000
AT_TEAM_RATE_LIMIT_WINDOW_MS=60000
AT_TEAM_RATE_LIMIT_MAX=600

# Frontend API target when UI and API are served separately.
VITE_AT_TEAM_API_BASE_URL=http://127.0.0.1:5174
VITE_AT_TEAM_API_TOKEN=

# Real manager smoke-test overrides.
AT_TEAM_API=http://127.0.0.1:5174
AT_MANAGER_SMOKE_EXPECTED=AT manager smoke OK
AT_MANAGER_SMOKE_TIMEOUT_MS=90000

# Package install behavior.
# Set to 1 in CI or scripted installs to skip the interactive setup wizard.
# Example for CI: AT_SETUP_SKIP_ON_INSTALL=1
AT_SETUP_SKIP_ON_INSTALL=
