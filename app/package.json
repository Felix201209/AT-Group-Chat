{
  "name": "at-group-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "AT_TEAM_AGENT_MODE=mock node scripts/dev.mjs",
    "dev:server": "node server/http.js",
    "dev:codex-server": "node scripts/codex-server.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "node server/http.js",
    "mcp": "node server/mcp.js",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:browser": "npm run build && playwright test tests/ui-smoke.spec.js tests/ui-customize.spec.js --project=chromium",
    "health": "node scripts/health.mjs",
    "preflight": "node server/preflight.js",
    "smoke:manager": "node scripts/manager-smoke.mjs",
    "verify": "npm run typecheck && npm run health && npm run test:browser && npm run audit",
    "verify:complete": "npm run audit:complete && npm run health && npm run test:browser && npm run smoke:manager && npm run audit:complete",
    "audit": "node scripts/completion-audit.mjs",
    "audit:complete": "node scripts/completion-audit.mjs --require-cutoff"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
